component ContactForm
  state
    form
      name: ""
      email: ""
      subject: ""
      message: ""
    errors
      name: ""
      email: ""
      subject: ""
      message: ""
    submitted: false
    loading: false

  layout
    view.container:
      view.header:
        text: "Contact Us"
        text.subtitle: "We'd love to hear from you"
      view.card:
        if (submitted):
          view.success:
            text: "✓ Message sent successfully!"
            text.subtitle: "We'll get back to you soon."
            button.btn-primary (on click -> reset): "Send Another"
        else:
          view.form:
            view.form-group:
              text.label: "Name"
              input.form-input (bind value <-> form.name) (on blur -> validateName): ""
              if (errors.name):
                text.error: "{{errors.name}}"

            view.form-group:
              text.label: "Email"
              input.form-input (type email) (bind value <-> form.email) (on blur -> validateEmail): ""
              if (errors.email):
                text.error: "{{errors.email}}"

            view.form-group:
              text.label: "Subject"
              input.form-input (bind value <-> form.subject) (on blur -> validateSubject): ""
              if (errors.subject):
                text.error: "{{errors.subject}}"

            view.form-group:
              text.label: "Message"
              input.form-textarea (bind value <-> form.message) (on blur -> validateMessage): ""
              if (errors.message):
                text.error: "{{errors.message}}"

            view.actions:
              button.btn-primary (on click -> submit) (disabled loading): "{{loading ? 'Sending...' : 'Send Message'}}"
              button.btn-secondary (on click -> reset): "Clear"

  handlers
    validateName
      if (form.name.trim() === "")
        errors.name = "Name is required"
      else if (form.name.length < 2)
        errors.name = "Name must be at least 2 characters"
      else
        errors.name = ""

    validateEmail
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
      if (form.email.trim() === "")
        errors.email = "Email is required"
      else if (!emailRegex.test(form.email))
        errors.email = "Please enter a valid email"
      else
        errors.email = ""

    validateSubject
      if (form.subject.trim() === "")
        errors.subject = "Subject is required"
      else if (form.subject.length < 3)
        errors.subject = "Subject must be at least 3 characters"
      else
        errors.subject = ""

    validateMessage
      if (form.message.trim() === "")
        errors.message = "Message is required"
      else if (form.message.length < 10)
        errors.message = "Message must be at least 10 characters"
      else
        errors.message = ""

    submit
      validateName()
      validateEmail()
      validateSubject()
      validateMessage()

      if (!errors.name && !errors.email && !errors.subject && !errors.message)
        loading = true
        setTimeout(() => {
          submitted = true
          loading = false
        }, 1500)

    reset
      form = { name: "", email: "", subject: "", message: "" }
      errors = { name: "", email: "", subject: "", message: "" }
      submitted = false

  style
    .container
      padding 24px
      max-width 700px
      margin 0 auto
      background linear-gradient(135deg, #667eea 0%, #764ba2 100%)
      min-height 100vh
      font family "Inter, system-ui, sans-serif"

    .header
      text-align center
      margin-bottom 32px

    .header text
      font size 36px
      font weight 700
      color white

    .header .subtitle
      font size 16px
      color rgba(255, 255, 255, 0.8)
      margin-top 8px

    .card
      background white
      border-radius 12px
      padding 32px
      box-shadow 0 20px 60px rgba(0, 0, 0, 0.3)

    .success
      text-align center
      padding 32px

    .success text
      font size 24px
      font weight 700
      color #10b981

    .success .subtitle
      font size 16px
      color #6b7280
      margin-top 12px

    .form
      display flex
      flex-direction column
      gap 24px

    .form-group
      display flex
      flex-direction column
      gap 8px

    .label
      font size 14px
      font weight 600
      color #1f2937

    .form-input
      padding 12px 16px
      border 2px solid #e5e7eb
      border-radius 8px
      font size 16px
      transition border-color 0.3s ease

    .form-input:focus
      outline none
      border-color #667eea

    .form-textarea
      padding 12px 16px
      border 2px solid #e5e7eb
      border-radius 8px
      font size 16px
      min-height 120px
      resize vertical
      transition border-color 0.3s ease

    .form-textarea:focus
      outline none
      border-color #667eea

    .error
      font size 13px
      color #ef4444
      font weight 500

    .actions
      display flex
      gap 12px
      margin-top 12px

    .btn-primary
      flex 1
      padding 12px 24px
      background #667eea
      color white
      border none
      border-radius 8px
      font weight 600
      cursor pointer
      transition all 0.3s ease

    .btn-primary:hover:not(:disabled)
      background #5568d3
      transform translateY(-2px)

    .btn-primary:disabled
      opacity 0.6
      cursor not-allowed

    .btn-secondary
      flex 1
      padding 12px 24px
      background #e5e7eb
      color #1f2937
      border none
      border-radius 8px
      font weight 600
      cursor pointer
      transition all 0.3s ease

    .btn-secondary:hover
      background #d1d5db
