component EcommerceProduct
  state
    product
      id: 1
      name: "Premium Wireless Headphones"
      price: 299.99
      rating: 4.5
      reviews: 128
      stock: 45
      description: "High-quality wireless headphones with noise cancellation and 30-hour battery life"
      images: ["image1.jpg", "image2.jpg", "image3.jpg"]
      specs
        battery: "30 hours"
        weight: "250g"
        connectivity: "Bluetooth 5.0"
        colors: ["Black", "Silver", "Gold"]
    selectedImage: 0
    selectedColor: "Black"
    quantity: 1
    inCart: false
    showNotification: false

  layout
    view.container:
      view.product-section:
        view.image-gallery:
          view.main-image:
            text: "{{product.images[selectedImage]}}"
          view.thumbnail-list:
            for (i in product.images):
              view.thumbnail (on click -> selectImage(i)): "{{i + 1}}"

        view.product-info:
          text.product-name: "{{product.name}}"

          view.rating:
            text.stars: "★ {{product.rating}}"
            text.reviews: "({{product.reviews}} reviews)"

          text.price: "${{product.price}}"

          text.description: "{{product.description}}"

          view.specs:
            text.specs-title: "Specifications"
            view.spec-item:
              text.spec-label: "Battery Life"
              text.spec-value: "{{product.specs.battery}}"
            view.spec-item:
              text.spec-label: "Weight"
              text.spec-value: "{{product.specs.weight}}"
            view.spec-item:
              text.spec-label: "Connectivity"
              text.spec-value: "{{product.specs.connectivity}}"

          view.color-selector:
            text.color-label: "Color"
            view.colors:
              for (color in product.specs.colors):
                button.color-btn (on click -> selectColor(color)): "{{color}}"

          view.quantity-selector:
            text.qty-label: "Quantity"
            view.qty-controls:
              button.qty-btn (on click -> decreaseQty): "−"
              text.qty-value: "{{quantity}}"
              button.qty-btn (on click -> increaseQty): "+"

          view.actions:
            button.btn-add-cart (on click -> addToCart): "Add to Cart"
            button.btn-wishlist: "♡ Wishlist"

          if (showNotification):
            view.notification:
              text: "✓ Added {{quantity}} item(s) to cart"

  handlers
    selectImage(index)
      selectedImage = index

    selectColor(color)
      selectedColor = color

    increaseQty
      if (quantity < product.stock)
        quantity = quantity + 1

    decreaseQty
      if (quantity > 1)
        quantity = quantity - 1

    addToCart
      inCart = true
      showNotification = true
      setTimeout(() => {
        showNotification = false
      }, 3000)

  style
    .container
      padding 24px
      max-width 1200px
      margin 0 auto
      background white
      font family "Inter, system-ui, sans-serif"

    .product-section
      display grid
      grid-template-columns 1fr 1fr
      gap 40px

    .image-gallery
      display flex
      flex-direction column
      gap 16px

    .main-image
      width 100%
      aspect-ratio 1
      background linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%)
      border-radius 12px
      display flex
      align-items center
      justify-content center
      font size 18px
      color #9ca3af

    .thumbnail-list
      display flex
      gap 12px

    .thumbnail
      width 80px
      height 80px
      background #f3f4f6
      border-radius 8px
      border 2px solid transparent
      cursor pointer
      display flex
      align-items center
      justify-content center
      font size 12px
      color #9ca3af
      transition all 0.3s ease

    .thumbnail:hover
      border-color #667eea

    .product-info
      display flex
      flex-direction column
      gap 20px

    .product-name
      font size 28px
      font weight 700
      color #1f2937

    .rating
      display flex
      gap 12px
      align-items center

    .rating .stars
      font size 18px
      color #fbbf24
      font weight 600

    .rating .reviews
      font size 14px
      color #6b7280

    .price
      font size 32px
      font weight 700
      color #667eea

    .description
      font size 16px
      color #4b5563
      line-height 1.6

    .specs
      border-top 1px solid #e5e7eb
      border-bottom 1px solid #e5e7eb
      padding 16px 0

    .specs-title
      font size 14px
      font weight 700
      color #1f2937
      margin-bottom 12px

    .spec-item
      display flex
      justify-content space-between
      padding 8px 0

    .spec-label
      font size 14px
      color #6b7280

    .spec-value
      font size 14px
      font weight 600
      color #1f2937

    .color-selector
      display flex
      flex-direction column
      gap 12px

    .color-label
      font size 14px
      font weight 600
      color #1f2937

    .colors
      display flex
      gap 12px

    .color-btn
      padding 10px 16px
      background white
      border 2px solid #e5e7eb
      border-radius 6px
      font size 14px
      font weight 600
      color #6b7280
      cursor pointer
      transition all 0.3s ease

    .color-btn:hover
      border-color #667eea
      color #667eea

    .quantity-selector
      display flex
      flex-direction column
      gap 12px

    .qty-label
      font size 14px
      font weight 600
      color #1f2937

    .qty-controls
      display flex
      align-items center
      gap 12px
      width fit-content

    .qty-btn
      width 40px
      height 40px
      background #f3f4f6
      border none
      border-radius 6px
      font size 18px
      cursor pointer
      transition all 0.3s ease

    .qty-btn:hover
      background #e5e7eb

    .qty-value
      font size 16px
      font weight 600
      color #1f2937
      min-width 30px
      text-align center

    .actions
      display flex
      gap 12px

    .btn-add-cart
      flex 1
      padding 14px 24px
      background #667eea
      color white
      border none
      border-radius 8px
      font size 16px
      font weight 700
      cursor pointer
      transition all 0.3s ease

    .btn-add-cart:hover
      background #5568d3
      transform translateY(-2px)
      box-shadow 0 8px 16px rgba(102, 126, 234, 0.4)

    .btn-wishlist
      padding 14px 24px
      background white
      color #667eea
      border 2px solid #667eea
      border-radius 8px
      font size 16px
      font weight 700
      cursor pointer
      transition all 0.3s ease

    .btn-wishlist:hover
      background #f3f4f6

    .notification
      padding 16px
      background #d1fae5
      border-left 4px solid #10b981
      border-radius 6px

    .notification text
      font size 14px
      color #065f46
      font weight 600
