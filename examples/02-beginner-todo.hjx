component TodoApp
  state
    todos: []
    input: ""

  layout
    view.container:
      view.header:
        text: "My Todo List"
      view.card:
        view.input-group:
          input.todo-input (bind value <-> input) (on keydown -> handleKeydown): ""
          button.btn-add (on click -> addTodo): "Add"
        view.stats:
          text: "Total: {{todos.length}} | Done: {{todos.filter(t => t.done).length}}"
        view.list:
          for (todo in todos):
            view.todo-item:
              input.checkbox (type checkbox) (bind checked <-> todo.done)
              text.todo-text: "{{todo.text}}"
              button.btn-delete (on click -> deleteTodo(todo.id)): "×"

  handlers
    addTodo
      if (input.trim() !== "")
        todos = [...todos, { id: Date.now(), text: input, done: false }]
        input = ""

    deleteTodo(id)
      todos = todos.filter(t => t.id !== id)

    handleKeydown(e)
      if (e.key === "Enter")
        addTodo()

  style
    .container
      padding 24px
      max-width 800px
      margin 0 auto
      background linear-gradient(135deg, #667eea 0%, #764ba2 100%)
      min-height 100vh
      font family "Inter, system-ui, sans-serif"

    .header
      text-align center
      margin-bottom 32px

    .header text
      font size 36px
      font weight 700
      color white

    .card
      background white
      border-radius 12px
      padding 32px
      box-shadow 0 20px 60px rgba(0, 0, 0, 0.3)

    .input-group
      display flex
      gap 12px
      margin-bottom 24px

    .todo-input
      flex 1
      padding 12px 16px
      border 2px solid #e5e7eb
      border-radius 8px
      font size 16px
      transition border-color 0.3s ease

    .todo-input:focus
      outline none
      border-color #667eea

    .btn-add
      padding 12px 24px
      background #667eea
      color white
      border none
      border-radius 8px
      font weight 600
      cursor pointer
      transition all 0.3s ease

    .btn-add:hover
      background #5568d3
      transform translateY(-2px)

    .stats
      padding 12px 16px
      background #f3f4f6
      border-radius 8px
      margin-bottom 24px
      text-align center

    .stats text
      font size 14px
      color #6b7280
      font weight 500

    .list
      display flex
      flex-direction column
      gap 12px

    .todo-item
      display flex
      align-items center
      gap 12px
      padding 16px
      background #f9fafb
      border-radius 8px
      border-left 4px solid #667eea
      transition all 0.3s ease

    .todo-item:hover
      background #f3f4f6

    .checkbox
      width 20px
      height 20px
      cursor pointer

    .todo-text
      flex 1
      font size 16px
      color #1f2937

    .btn-delete
      padding 4px 8px
      background #ef4444
      color white
      border none
      border-radius 4px
      font size 18px
      cursor pointer
      transition all 0.3s ease

    .btn-delete:hover
      background #dc2626
