component TodoApp
state:
  items = []
  newItem = ""
layout:
  view.container:
    input (bind value <-> newItem):
    button (on click -> addItem): "Add"
    for (item in items):
      view.item:
        text: "{{item}}"
handlers:
  addItem:
    set items = [...items, newItem]
    set newItem = ""
