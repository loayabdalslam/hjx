component WelcomeScreen

state:
  suggestions = [
    { icon: "💻", title: "Write code", prompt: "Write a Python function that sorts a list" },
    { icon: "📝", title: "Draft text", prompt: "Write a professional email template" },
    { icon: "🔍", title: "Explain concept", prompt: "Explain how async/await works in JavaScript" },
    { icon: "🎨", title: "Generate ideas", prompt: "Give me 5 creative project ideas for a portfolio" }
  ]

layout:
  view.welcome:
    view.welcome-content:
      text.welcome-icon: "💬"
      text.welcome-title: "How can I help you today?"
      text.welcome-sub: "Start a conversation or pick a suggestion"

      view.suggestions-grid:
        for (suggestion in suggestions):
          view.suggestion-card (on click -> startSuggestion):
            text.suggestion-icon: "{{suggestion.icon}}"
            text.suggestion-title: "{{suggestion.title}}"
            text.suggestion-prompt: "{{suggestion.prompt}}"

      view.provider-info:
        text: "Powered by HJX AI • Supports Groq, OpenRouter, Ollama"

style:
  .welcome { flex: 1; display: flex; align-items: center; justify-content: center; padding: 40px; }
  .welcome-content { text-align: center; max-width: 600px; }
  .welcome-icon { font-size: 48px; margin-bottom: 16px; }
  .welcome-title { font-size: 28px; font-weight: 700; color: #111827; margin-bottom: 8px; }
  .welcome-sub { color: #6b7280; margin-bottom: 32px; }
  .suggestions-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 32px; }
  .suggestion-card { padding: 20px; background: white; border: 1px solid #e5e7eb; border-radius: 12px; cursor: pointer; text-align: left; transition: all 0.2s; }
  .suggestion-card:hover { border-color: #3b82f6; box-shadow: 0 4px 12px rgba(59,130,246,0.1); }
  .suggestion-icon { font-size: 24px; margin-bottom: 8px; }
  .suggestion-title { font-weight: 600; margin-bottom: 4px; }
  .suggestion-prompt { font-size: 13px; color: #6b7280; line-height: 1.4; }
  .provider-info { font-size: 12px; color: #9ca3af; }

handlers:
  startSuggestion:
    log "Start suggestion"
