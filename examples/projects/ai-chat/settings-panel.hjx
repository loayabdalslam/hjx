component SettingsPanel

state:
  localProvider = ""
  localModel = ""
  apiKey = ""
  temperature = 0.7
  maxTokens = 4096
  activeTab = "general"

layout:
  view.settings-overlay(on click -> close):
    view.settings-panel(on click -> stopPropagation):
      view.settings-header:
        text.settings-title: "Settings"
        button.close-btn (on click -> close): "×"

      view.settings-tabs:
        button.tab(class="tab-{{activeTab === 'general' ? 'active' : ''}}" on click -> setTab): "General"
        button.tab(class="tab-{{activeTab === 'model' ? 'active' : ''}}" on click -> setTab): "Model"
        button.tab(class="tab-{{activeTab === 'usage' ? 'active' : ''}}" on click -> setTab): "Usage"

      if (activeTab === "general"):
        view.settings-section:
          view.setting-row:
            text.setting-label: "AI Provider"
            view.provider-options:
              button.provider-opt(class="sel-{{localProvider === 'groq'}}" on click -> setProvider): "Groq ⚡"
              button.provider-opt(class="sel-{{localProvider === 'openrouter'}}" on click -> setProvider): "OpenRouter"
              button.provider-opt(class="sel-{{localProvider === 'ollama'}}" on click -> setProvider): "Ollama 🏠"
          view.setting-row:
            text.setting-label: "API Key"
            input.setting-input (type="password" placeholder="Enter API key" bind value <-> apiKey)
          view.setting-row:
            text.setting-label: "Temperature: {{temperature}}"
            view.slider-container:
              text: "Precise"
              text: "Creative"
          view.setting-row:
            text.setting-label: "Max Tokens"
            input.setting-input (type="number" placeholder="4096" bind value <-> maxTokens)

      if (activeTab === "model"):
        view.settings-section:
          text.section-subtitle: "Available Models"
          view.model-list:
            view.model-card(class="sel-{{localModel === 'llama-3.3-70b'}}"):
              text.model-name: "Llama 3.3 70B"
              text.model-info: "Fast • Groq"
            view.model-card(class="sel-{{localModel === 'claude-3.5'}}"):
              text.model-name: "Claude 3.5 Sonnet"
              text.model-info: "Best quality • OpenRouter"
            view.model-card(class="sel-{{localModel === 'gpt-4'}}"):
              text.model-name: "GPT-4o"
              text.model-info: "Balanced • OpenRouter"

      if (activeTab === "usage"):
        view.settings-section:
          view.usage-stat:
            text.usage-value: "12,450"
            text.usage-label: "Total Tokens"
          view.usage-stat:
            text.usage-value: "$0.87"
            text.usage-label: "Estimated Cost"
          view.usage-stat:
            text.usage-value: "23"
            text.usage-label: "Conversations"

      view.settings-footer:
        button.cancel-btn (on click -> close): "Cancel"
        button.save-btn (on click -> save): "Save Changes"

style:
  .settings-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 100; }
  .settings-panel { background: white; border-radius: 16px; width: 480px; max-height: 80vh; overflow-y: auto; }
  .settings-header { display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid #e5e7eb; }
  .settings-title { font-size: 18px; font-weight: 700; }
  .close-btn { background: none; border: none; font-size: 24px; cursor: pointer; color: #9ca3af; }
  .settings-tabs { display: flex; border-bottom: 1px solid #e5e7eb; }
  .tab { flex: 1; padding: 12px; background: none; border: none; cursor: pointer; font-size: 14px; font-weight: 500; color: #6b7280; border-bottom: 2px solid transparent; }
  .tab-active { color: #3b82f6; border-bottom-color: #3b82f6; }
  .settings-section { padding: 24px; }
  .setting-row { margin-bottom: 20px; }
  .setting-label { display: block; font-size: 14px; font-weight: 500; margin-bottom: 8px; }
  .setting-input { width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; }
  .provider-options { display: flex; gap: 8px; }
  .provider-opt { padding: 8px 16px; border: 1px solid #e5e7eb; border-radius: 8px; background: white; cursor: pointer; font-size: 13px; }
  .sel-true { border-color: #3b82f6; background: #eff6ff; }
  .slider-container { display: flex; justify-content: space-between; font-size: 12px; color: #9ca3af; }
  .section-subtitle { font-size: 14px; font-weight: 600; margin-bottom: 12px; }
  .model-list { display: flex; flex-direction: column; gap: 8px; }
  .model-card { padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 10px; cursor: pointer; }
  .model-card.sel-true { border-color: #3b82f6; background: #eff6ff; }
  .model-name { font-weight: 600; font-size: 14px; }
  .model-info { font-size: 12px; color: #6b7280; }
  .usage-stat { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #f3f4f6; }
  .usage-value { font-weight: 700; font-size: 18px; }
  .usage-label { color: #6b7280; font-size: 14px; }
  .settings-footer { display: flex; justify-content: flex-end; gap: 12px; padding: 16px 24px; border-top: 1px solid #e5e7eb; }
  .cancel-btn { padding: 10px 20px; background: none; border: 1px solid #e5e7eb; border-radius: 8px; cursor: pointer; }
  .save-btn { padding: 10px 20px; background: #3b82f6; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; }

handlers:
  close:
    log "Close settings"
  stopPropagation:
    log "Stop propagation"
  setProvider:
    log "Set provider"
  setTab:
    set activeTab = ctx.el.dataset.tab
  save:
    log "Save settings"
