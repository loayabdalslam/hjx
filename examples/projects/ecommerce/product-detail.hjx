component ProductDetail

imports:
  StarRating from "./components/StarRating.hjx"
  PriceTag from "./components/PriceTag.hjx"

state:
  product = { id: "", name: "", price: 0, image: "", description: "", rating: 0, stock: 0, specs: [] }
  quantity = 1
  selectedImage = ""
  reviews = [
    { user: "Alice", rating: 5, text: "Amazing quality! Highly recommend.", date: "2026-01-15" },
    { user: "Bob", rating: 4, text: "Great product, fast shipping.", date: "2026-01-10" },
    { user: "Carol", rating: 5, text: "Exceeded my expectations.", date: "2026-01-05" }
  ]
  activeTab = "description"
  isWishlisted = false
  showZoom = false

script:
  export function init(store) {
    // Fetch product details from API
    // const id = store.get("productId");
    // fetch(`/api/products/${id}`).then(r => r.json()).then(p => store.set({ product: p, selectedImage: p.image }));
  }

layout:
  view.product-detail:
    button.back-btn (on click -> goBack): "← Back to Shop"

    view.product-layout:
      view.gallery:
        view.main-image:
          view.image-container(on click -> toggleZoom):
            text: "📷 {{product.name}}"
        view.thumbnail-strip:
          view.thumb.active: "1"
          view.thumb: "2"
          view.thumb: "3"

      view.product-info:
        text.category: "Category"
        text.product-name: "{{product.name}}"
        StarRating (rating="{{product.rating}}" reviews="{{reviews.length}}")
        PriceTag (price="{{product.price}}")

        if (product.stock > 0):
          view.stock-indicator.in-stock: "✓ In Stock ({{product.stock}} available)"
        if (product.stock === 0):
          view.stock-indicator.out-of-stock: "✗ Out of Stock"

        view.quantity-selector:
          button.qty-btn (on click -> decreaseQty): "−"
          text.qty-value: "{{quantity}}"
          button.qty-btn (on click -> increaseQty): "+"

        view.actions:
          button.add-to-cart-btn (on click -> addToCart): "Add to Cart - ${{(product.price * quantity).toFixed(2)}}"
          button.wishlist-btn(class="wishlisted-{{isWishlisted}}" on click -> toggleWishlist): "♥"

    view.details-tabs:
      view.tab-bar:
        button.tab(class="tab-{{activeTab === 'description' ? 'active' : ''}}" on click -> setTab): "Description"
        button.tab(class="tab-{{activeTab === 'specs' ? 'active' : ''}}" on click -> setTab): "Specifications"
        button.tab(class="tab-{{activeTab === 'reviews' ? 'active' : ''}}" on click -> setTab): "Reviews ({{reviews.length}})"

      if (activeTab === "description"):
        view.tab-content:
          text: "This premium product delivers exceptional quality and performance. Crafted with attention to detail, it's designed to exceed your expectations."

      if (activeTab === "specs"):
        view.tab-content:
          view.specs-table:
            view.spec-row:
              text.spec-label: "Brand"
              text.spec-value: "Premium Store"
            view.spec-row:
              text.spec-label: "Weight"
              text.spec-value: "0.5 kg"
            view.spec-row:
              text.spec-label: "Dimensions"
              text.spec-value: "25 × 15 × 10 cm"

      if (activeTab === "reviews"):
        view.tab-content:
          for (review in reviews):
            view.review-card:
              view.review-header:
                text.review-user: "{{review.user}}"
                StarRating (rating="{{review.rating}}")
                text.review-date: "{{review.date}}"
              text.review-text: "{{review.text}}"

style:
  .product-detail { padding: 0; }
  .back-btn { background: none; border: none; color: #3b82f6; cursor: pointer; font-size: 14px; margin-bottom: 24px; padding: 8px 0; }
  .product-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; margin-bottom: 48px; }
  .gallery { position: sticky; top: 24px; }
  .main-image { background: #f3f4f6; border-radius: 16px; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; font-size: 48px; cursor: zoom-in; margin-bottom: 12px; }
  .thumbnail-strip { display: flex; gap: 8px; }
  .thumb { width: 64px; height: 64px; background: #f3f4f6; border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer; border: 2px solid transparent; font-size: 12px; color: #9ca3af; }
  .active { border-color: #3b82f6; }
  .product-info { display: flex; flex-direction: column; gap: 16px; }
  .category { font-size: 12px; text-transform: uppercase; color: #6b7280; letter-spacing: 1px; }
  .product-name { font-size: 28px; font-weight: 700; color: #111827; }
  .stock-indicator { font-size: 14px; font-weight: 500; }
  .in-stock { color: #059669; }
  .out-of-stock { color: #dc2626; }
  .quantity-selector { display: flex; align-items: center; gap: 16px; }
  .qty-btn { width: 36px; height: 36px; border: 1px solid #e5e7eb; border-radius: 8px; background: white; cursor: pointer; font-size: 18px; display: flex; align-items: center; justify-content: center; }
  .qty-value { font-size: 18px; font-weight: 600; min-width: 32px; text-align: center; }
  .actions { display: flex; gap: 12px; }
  .add-to-cart-btn { flex: 1; padding: 14px 24px; background: #3b82f6; color: white; border: none; border-radius: 12px; font-size: 16px; font-weight: 600; cursor: pointer; }
  .add-to-cart-btn:hover { background: #2563eb; }
  .wishlist-btn { width: 48px; height: 48px; border: 1px solid #e5e7eb; border-radius: 12px; background: white; cursor: pointer; font-size: 20px; }
  .wishlisted-true { color: #ef4444; border-color: #ef4444; }
  .details-tabs { border-top: 1px solid #e5e7eb; padding-top: 32px; }
  .tab-bar { display: flex; gap: 0; border-bottom: 1px solid #e5e7eb; margin-bottom: 24px; }
  .tab { padding: 12px 24px; background: none; border: none; cursor: pointer; font-size: 14px; font-weight: 500; color: #6b7280; border-bottom: 2px solid transparent; margin-bottom: -1px; }
  .tab-active { color: #3b82f6; border-bottom-color: #3b82f6; }
  .tab-content { padding: 16px 0; color: #4b5563; line-height: 1.7; }
  .specs-table { width: 100%; }
  .spec-row { display: flex; padding: 12px 0; border-bottom: 1px solid #f3f4f6; }
  .spec-label { width: 140px; font-weight: 500; color: #374151; }
  .spec-value { color: #6b7280; }
  .review-card { padding: 20px; background: #f9fafb; border-radius: 12px; margin-bottom: 12px; }
  .review-header { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
  .review-user { font-weight: 600; color: #111827; }
  .review-date { font-size: 12px; color: #9ca3af; margin-left: auto; }
  .review-text { color: #4b5563; line-height: 1.5; }

handlers:
  goBack:
    log "Go back to shop"
  toggleZoom:
    set showZoom = !showZoom
  decreaseQty:
    set quantity = Math.max(1, quantity - 1)
  increaseQty:
    set quantity = Math.min(product.stock, quantity + 1)
  addToCart:
    log "Adding {{quantity}} of {{product.name}} to cart"
  toggleWishlist:
    set isWishlisted = !isWishlisted
  setTab:
    set activeTab = ctx.el.dataset.tab
