component Storefront

imports:
  ProductCard from "./components/ProductCard.hjx"
  SearchBar from "./components/SearchBar.hjx"
  FilterPanel from "./components/FilterPanel.hjx"

state:
  products = [
    { id: "1", name: "Wireless Headphones", price: 79.99, image: "/img/headphones.jpg", rating: 4.5, category: "electronics", stock: 42 },
    { id: "2", name: "Leather Backpack", price: 129.99, image: "/img/backpack.jpg", rating: 4.8, category: "accessories", stock: 18 },
    { id: "3", name: "Smart Watch Pro", price: 299.99, image: "/img/watch.jpg", rating: 4.2, category: "electronics", stock: 7 },
    { id: "4", name: "Running Shoes", price: 89.99, image: "/img/shoes.jpg", rating: 4.6, category: "sports", stock: 35 },
    { id: "5", name: "Coffee Maker", price: 149.99, image: "/img/coffee.jpg", rating: 4.9, category: "home", stock: 23 },
    { id: "6", name: "Yoga Mat Premium", price: 49.99, image: "/img/yoga.jpg", rating: 4.3, category: "sports", stock: 56 }
  ]
  searchQuery = ""
  selectedCategory = "all"
  sortBy = "featured"
  currentPage = 1
  itemsPerPage = 12
  categories = ["all", "electronics", "accessories", "sports", "home"]

script:
  export function init(store) {
    // In production: fetch from API
    // fetch("/api/products").then(r => r.json()).then(data => store.set({ products: data }));
  }

layout:
  view.storefront:
    view.store-header:
      text.page-title: "Shop"
      text.results-count: "{{filteredProducts.length}} products"

    view.toolbar:
      SearchBar (bind value <-> searchQuery on search -> performSearch)
      view.toolbar-right:
        FilterPanel (categories="{{categories}}" selected="{{selectedCategory}}" on filter -> filterByCategory)
        view.sort-dropdown:
          text: "Sort by:"
          view.select-wrapper:
            text: "{{sortBy}}"

    view.product-grid:
      if (filteredProducts.length === 0):
        view.empty-state:
          text.empty-icon: "🔍"
          text: "No products found"
          text.sub: "Try adjusting your search or filters"

      for (product in filteredProducts):
        ProductCard (product="{{product}}" on view -> viewProduct on addToCart -> addToCart)

    if (totalPages > 1):
      view.pagination:
        button.page-btn (on click -> prevPage): "← Previous"
        for (page in pageNumbers):
          button.page-btn(class="page-{{page === currentPage ? 'active' : ''}}" on click -> goToPage): "{{page}}"
        button.page-btn (on click -> nextPage): "Next →"

style:
  .storefront { padding: 0; }
  .store-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .page-title { font-size: 32px; font-weight: 800; color: #111827; }
  .results-count { color: #6b7280; font-size: 14px; }
  .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 32px; flex-wrap: wrap; }
  .toolbar-right { display: flex; gap: 12px; align-items: center; }
  .sort-dropdown { display: flex; align-items: center; gap: 8px; color: #6b7280; font-size: 14px; }
  .select-wrapper { padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 8px; background: white; cursor: pointer; }
  .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; }
  .empty-state { grid-column: 1 / -1; text-align: center; padding: 64px 24px; color: #9ca3af; }
  .empty-icon { font-size: 48px; margin-bottom: 16px; }
  .sub { font-size: 14px; margin-top: 8px; }
  .pagination { display: flex; justify-content: center; gap: 8px; margin-top: 40px; }
  .page-btn { padding: 8px 16px; border: 1px solid #e5e7eb; border-radius: 8px; background: white; cursor: pointer; font-size: 14px; }
  .page-active { background: #3b82f6; color: white; border-color: #3b82f6; }

computed:
  filteredProducts = products.filter(p => (selectedCategory === "all" || p.category === selectedCategory) && (searchQuery === "" || p.name.toLowerCase().includes(searchQuery.toLowerCase())))
  totalPages = Math.ceil(filteredProducts.length / itemsPerPage)
  pageNumbers = Array.from({ length: totalPages }, (_, i) => i + 1)

handlers:
  performSearch:
    log "Searching: {{searchQuery}}"
    set currentPage = 1
  filterByCategory:
    set selectedCategory = ctx.el.dataset.category
    set currentPage = 1
  viewProduct:
    log "View product"
  addToCart:
    log "Add to cart"
  prevPage:
    set currentPage = Math.max(1, currentPage - 1)
  nextPage:
    set currentPage = Math.min(totalPages, currentPage + 1)
  goToPage:
    set currentPage = parseInt(ctx.el.textContent)
