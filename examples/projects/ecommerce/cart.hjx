component Cart

imports:
  PriceTag from "./components/PriceTag.hjx"

state:
  items = []
  promoCode = ""
  promoDiscount = 0
  promoApplied = false
  promoError = ""

script:
  export function init(store) {
    // Items passed via props in production
  }

layout:
  view.cart-page:
    text.page-title: "Shopping Cart"
    text.item-count: "{{items.length}} items"

    if (items.length === 0):
      view.empty-cart:
        text.empty-icon: "🛒"
        text: "Your cart is empty"
        text.sub: "Add items to get started"
        button.shop-btn (on click -> goShop): "Continue Shopping"

    if (items.length > 0):
      view.cart-layout:
        view.cart-items:
          for (item in items):
            view.cart-item:
              view.item-image:
                text: "📷"
              view.item-details:
                text.item-name: "{{item.name}}"
                text.item-variant: "{{item.variant}}"
                PriceTag (price="{{item.price}}")
              view.item-quantity:
                button.qty-btn (on click -> decreaseQty): "−"
                text.qty: "{{item.quantity}}"
                button.qty-btn (on click -> increaseQty): "+"
              view.item-total:
                PriceTag (price="{{item.price * item.quantity}}")
              button.remove-btn (on click -> removeItem): "🗑"

        view.cart-summary:
          text.summary-title: "Order Summary"

          view.summary-row:
            text: "Subtotal"
            PriceTag (price="{{subtotal}}")

          if (promoApplied):
            view.summary-row.promo:
              text: "Promo ({{promoCode}})"
              text.discount: "-${{promoDiscount}}"

          view.summary-row:
            text: "Shipping"
            text: "{{subtotal > 50 ? 'Free' : '$9.99'}}"

          view.summary-row:
            text: "Tax (8%)"
            PriceTag (price="{{tax}}")

          view.promo-section:
            input.promo-input (placeholder="Promo code" bind value <-> promoCode)
            button.apply-btn (on click -> applyPromo): "Apply"
            if (promoError):
              text.promo-error: "{{promoError}}"

          view.summary-total:
            text: "Total"
            text.total-price: "${{total.toFixed(2)}}"

          button.checkout-btn (on click -> goCheckout): "Proceed to Checkout"

          view.secure-badge:
            text: "🔒 Secure checkout"

style:
  .cart-page { max-width: 960px; margin: 0 auto; }
  .page-title { font-size: 28px; font-weight: 700; margin-bottom: 4px; }
  .item-count { color: #6b7280; font-size: 14px; margin-bottom: 32px; }
  .empty-cart { text-align: center; padding: 64px 0; }
  .empty-icon { font-size: 64px; margin-bottom: 16px; }
  .sub { color: #9ca3af; margin-top: 8px; }
  .shop-btn { margin-top: 24px; padding: 12px 32px; background: #3b82f6; color: white; border: none; border-radius: 10px; cursor: pointer; font-weight: 600; }
  .cart-layout { display: grid; grid-template-columns: 1fr 360px; gap: 32px; }
  .cart-items { display: flex; flex-direction: column; gap: 16px; }
  .cart-item { display: flex; align-items: center; gap: 16px; padding: 20px; background: white; border: 1px solid #e5e7eb; border-radius: 12px; }
  .item-image { width: 80px; height: 80px; background: #f3f4f6; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 24px; }
  .item-details { flex: 1; }
  .item-name { font-weight: 600; margin-bottom: 4px; }
  .item-variant { font-size: 13px; color: #6b7280; margin-bottom: 8px; }
  .item-quantity { display: flex; align-items: center; gap: 8px; }
  .qty-btn { width: 28px; height: 28px; border: 1px solid #e5e7eb; border-radius: 6px; background: white; cursor: pointer; }
  .qty { font-weight: 600; min-width: 24px; text-align: center; }
  .item-total { font-weight: 700; min-width: 80px; text-align: right; }
  .remove-btn { background: none; border: none; cursor: pointer; font-size: 18px; padding: 8px; }
  .cart-summary { background: #f9fafb; border-radius: 16px; padding: 24px; height: fit-content; position: sticky; top: 24px; }
  .summary-title { font-size: 18px; font-weight: 700; margin-bottom: 20px; }
  .summary-row { display: flex; justify-content: space-between; padding: 10px 0; font-size: 14px; color: #4b5563; }
  .promo { color: #059669; }
  .discount { color: #059669; font-weight: 600; }
  .promo-section { display: flex; gap: 8px; margin: 16px 0; }
  .promo-input { flex: 1; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; }
  .apply-btn { padding: 10px 16px; background: #111827; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 14px; }
  .promo-error { color: #dc2626; font-size: 12px; margin-top: 4px; }
  .summary-total { display: flex; justify-content: space-between; padding: 16px 0; border-top: 1px solid #e5e7eb; font-size: 18px; font-weight: 700; }
  .total-price { color: #111827; }
  .checkout-btn { width: 100%; padding: 14px; background: #3b82f6; color: white; border: none; border-radius: 12px; font-size: 16px; font-weight: 600; cursor: pointer; margin-top: 16px; }
  .secure-badge { text-align: center; margin-top: 12px; font-size: 13px; color: #6b7280; }

computed:
  subtotal = items.reduce((sum, item) => sum + item.price * item.quantity, 0)
  tax = subtotal * 0.08
  total = subtotal - promoDiscount + (subtotal > 50 ? 0 : 9.99) + tax

handlers:
  goShop:
    log "Navigate to shop"
  goCheckout:
    log "Navigate to checkout"
  increaseQty:
    log "Increase quantity"
  decreaseQty:
    log "Decrease quantity"
  removeItem:
    log "Remove item from cart"
  applyPromo:
    if (promoCode === "SAVE10"):
      set promoDiscount = subtotal * 0.1
      set promoApplied = true
      set promoError = ""
    if (promoCode !== "SAVE10"):
      set promoError = "Invalid promo code"
      set promoApplied = false
