component AdminDashboard

state:
  activeSection = "overview"
  stats = { totalRevenue: 45280, ordersToday: 23, activeUsers: 156, conversionRate: 3.2 }
  recentOrders = [
    { id: "ORD-001", customer: "Alice M.", total: 159.98, status: "shipped", date: "2026-03-24" },
    { id: "ORD-002", customer: "Bob K.", total: 79.99, status: "processing", date: "2026-03-25" },
    { id: "ORD-003", customer: "Carol S.", total: 299.99, status: "pending", date: "2026-03-25" },
    { id: "ORD-004", customer: "Dan P.", total: 49.99, status: "delivered", date: "2026-03-23" }
  ]
  topProducts = [
    { name: "Smart Watch Pro", sold: 89, revenue: 26700 },
    { name: "Wireless Headphones", sold: 156, revenue: 12480 },
    { name: "Coffee Maker", sold: 67, revenue: 10050 }
  ]

layout:
  view.admin-layout:
    view.sidebar:
      text.sidebar-title: "Admin Panel"
      view.nav-items:
        button.nav-item(class="nav-{{activeSection === 'overview' ? 'active' : ''}}" on click -> setSection): "📊 Overview"
        button.nav-item(class="nav-{{activeSection === 'products' ? 'active' : ''}}" on click -> setSection): "📦 Products"
        button.nav-item(class="nav-{{activeSection === 'orders' ? 'active' : ''}}" on click -> setSection): "🛒 Orders"
        button.nav-item(class="nav-{{activeSection === 'customers' ? 'active' : ''}}" on click -> setSection): "👥 Customers"
        button.nav-item(class="nav-{{activeSection === 'settings' ? 'active' : ''}}" on click -> setSection): "⚙️ Settings"

    view.admin-content:
      if (activeSection === "overview"):
        text.section-title: "Dashboard Overview"

        view.stats-grid:
          view.stat-card:
            text.stat-value: "${{stats.totalRevenue.toLocaleString()}}"
            text.stat-label: "Total Revenue"
            text.stat-change.positive: "+12.5%"
          view.stat-card:
            text.stat-value: "{{stats.ordersToday}}"
            text.stat-label: "Orders Today"
            text.stat-change.positive: "+8.2%"
          view.stat-card:
            text.stat-value: "{{stats.activeUsers}}"
            text.stat-label: "Active Users"
            text.stat-change.negative: "-2.1%"
          view.stat-card:
            text.stat-value: "{{stats.conversionRate}}%"
            text.stat-label: "Conversion Rate"
            text.stat-change.positive: "+0.5%"

        view.two-col:
          view.section-card:
            text.card-title: "Recent Orders"
            for (order in recentOrders):
              view.order-row:
                text.order-id: "{{order.id}}"
                text.order-customer: "{{order.customer}}"
                text.order-total: "${{order.total}}"
                view.status-badge(class="status-{{order.status}}"): "{{order.status}}"

          view.section-card:
            text.card-title: "Top Products"
            for (product in topProducts):
              view.product-row:
                text.product-name: "{{product.name}}"
                text.product-sold: "{{product.sold}} sold"
                text.product-revenue: "${{product.revenue.toLocaleString()}}"

style:
  .admin-layout { display: grid; grid-template-columns: 240px 1fr; min-height: calc(100vh - 140px); gap: 0; }
  .sidebar { background: #111827; padding: 24px; border-radius: 16px; margin-right: 24px; }
  .sidebar-title { color: white; font-size: 18px; font-weight: 700; margin-bottom: 32px; }
  .nav-items { display: flex; flex-direction: column; gap: 4px; }
  .nav-item { padding: 10px 16px; background: none; border: none; color: #9ca3af; cursor: pointer; text-align: left; border-radius: 8px; font-size: 14px; }
  .nav-active { background: #1f2937; color: white; }
  .nav-item:hover { color: white; }
  .admin-content { flex: 1; }
  .section-title { font-size: 24px; font-weight: 700; margin-bottom: 24px; }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 32px; }
  .stat-card { background: white; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px; }
  .stat-value { font-size: 28px; font-weight: 700; color: #111827; }
  .stat-label { font-size: 13px; color: #6b7280; margin-top: 4px; }
  .stat-change { font-size: 12px; font-weight: 600; margin-top: 8px; }
  .positive { color: #059669; }
  .negative { color: #dc2626; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .section-card { background: white; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px; }
  .card-title { font-size: 16px; font-weight: 600; margin-bottom: 16px; }
  .order-row, .product-row { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #f3f4f6; font-size: 14px; }
  .order-id { font-weight: 600; }
  .order-customer { color: #6b7280; }
  .order-total { font-weight: 600; }
  .status-badge { padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; text-transform: uppercase; }
  .status-shipped { background: #dbeafe; color: #1d4ed8; }
  .status-processing { background: #fef3c7; color: #92400e; }
  .status-pending { background: #f3e8ff; color: #7c3aed; }
  .status-delivered { background: #dcfce7; color: #166534; }
  .product-name { font-weight: 500; }
  .product-sold { color: #6b7280; }
  .product-revenue { font-weight: 600; color: #059669; }

handlers:
  setSection:
    set activeSection = ctx.el.dataset.section
