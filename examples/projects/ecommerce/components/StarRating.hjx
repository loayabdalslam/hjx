component StarRating
layout:
  view.star-rating:
    text.stars: "{{'★'.repeat(Math.floor(rating))}}{{'☆'.repeat(5 - Math.floor(rating))}}"
    if (reviews):
      text.review-count: "({{reviews}} reviews)"

style:
  .star-rating { display: inline-flex; align-items: center; gap: 6px; }
  .stars { color: #f59e0b; font-size: 16px; letter-spacing: 2px; }
  .review-count { font-size: 13px; color: #6b7280; }
