component ProductCard

state:
  isHovered = false

layout:
  view.product-card(class="hovered-{{isHovered}}" on mouseenter -> onHover on mouseleave -> onLeave):
    view.image-wrapper:
      view.product-image:
        text: "📷"
      if (product.stock < 5 && product.stock > 0):
        view.badge.low-stock: "Only {{product.stock}} left"
      if (product.stock === 0):
        view.badge.out-of-stock-badge: "Sold Out"

    view.card-body:
      text.product-category: "{{product.category}}"
      text.product-name: "{{product.name}}"
      view.rating-row:
        text.stars: "{{'★'.repeat(Math.floor(product.rating))}}{{'☆'.repeat(5 - Math.floor(product.rating))}}"
        text.rating-num: "{{product.rating}}"
      view.price-row:
        text.price: "${{product.price.toFixed(2)}}"

    view.card-actions:
      button.view-btn (on click -> viewProduct): "View Details"
      button.cart-btn (on click -> addToCart class="disabled-{{product.stock === 0}}"): "Add to Cart"

style:
  .product-card { background: white; border: 1px solid #e5e7eb; border-radius: 16px; overflow: hidden; transition: all 0.2s; cursor: pointer; }
  .product-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); border-color: #d1d5db; }
  .image-wrapper { position: relative; }
  .product-image { aspect-ratio: 4/3; background: #f3f4f6; display: flex; align-items: center; justify-content: center; font-size: 48px; }
  .badge { position: absolute; top: 12px; left: 12px; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
  .low-stock { background: #fef3c7; color: #92400e; }
  .out-of-stock-badge { background: #fee2e2; color: #991b1b; }
  .card-body { padding: 16px; }
  .product-category { font-size: 11px; text-transform: uppercase; color: #9ca3af; letter-spacing: 1px; margin-bottom: 4px; }
  .product-name { font-size: 16px; font-weight: 600; color: #111827; margin-bottom: 8px; }
  .rating-row { display: flex; align-items: center; gap: 6px; margin-bottom: 8px; }
  .stars { color: #f59e0b; font-size: 14px; }
  .rating-num { font-size: 13px; color: #6b7280; }
  .price-row { display: flex; align-items: baseline; gap: 8px; }
  .price { font-size: 20px; font-weight: 700; color: #111827; }
  .card-actions { display: flex; gap: 8px; padding: 0 16px 16px; }
  .view-btn { flex: 1; padding: 10px; border: 1px solid #e5e7eb; border-radius: 10px; background: white; cursor: pointer; font-size: 13px; font-weight: 500; }
  .cart-btn { flex: 1; padding: 10px; border: none; border-radius: 10px; background: #3b82f6; color: white; cursor: pointer; font-size: 13px; font-weight: 500; }
  .disabled-true { background: #d1d5db; cursor: not-allowed; }

handlers:
  onHover:
    set isHovered = true
  onLeave:
    set isHovered = false
  viewProduct:
    log "View product"
  addToCart:
    log "Add to cart"
