component CartBadge
layout:
  if (cartCount > 0):
    view.badge: "{{cartCount}}"

style:
  .badge { min-width: 20px; height: 20px; background: #ef4444; color: white; border-radius: 10px; font-size: 11px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; padding: 0 6px; }
