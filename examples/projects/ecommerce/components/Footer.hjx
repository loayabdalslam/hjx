component Footer
layout:
  view.footer:
    view.footer-content:
      view.footer-brand:
        text.brand-name: "🛍 StoreApp"
        text.brand-tagline: "Shop the best products online"
      view.footer-links:
        view.link-col:
          text.col-title: "Shop"
          text.link: "All Products"
          text.link: "New Arrivals"
          text.link: "Best Sellers"
        view.link-col:
          text.col-title: "Support"
          text.link: "Help Center"
          text.link: "Shipping"
          text.link: "Returns"
        view.link-col:
          text.col-title: "Company"
          text.link: "About Us"
          text.link: "Careers"
          text.link: "Contact"
    view.footer-bottom:
      text.copyright: "© 2026 StoreApp. Built with HJX."

style:
  .footer { background: #111827; color: white; padding: 48px 0 24px; margin-top: auto; }
  .footer-content { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: 1fr 2fr; gap: 48px; }
  .brand-name { font-size: 20px; font-weight: 800; margin-bottom: 8px; }
  .brand-tagline { color: #9ca3af; font-size: 14px; }
  .footer-links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .col-title { font-weight: 600; margin-bottom: 16px; font-size: 14px; }
  .link { color: #9ca3af; font-size: 14px; margin-bottom: 8px; cursor: pointer; }
  .footer-bottom { max-width: 1200px; margin: 32px auto 0; padding: 24px 24px 0; border-top: 1px solid #1f2937; }
  .copyright { color: #6b7280; font-size: 13px; }
