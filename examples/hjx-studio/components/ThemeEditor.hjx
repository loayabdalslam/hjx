component ThemeEditor

state:
  primaryColor = "#6366f1"
  borderRadius = "12"
  fontFamily = "system-ui"
  presets = [
    { name: "Default", primary: "#6366f1", bg: "#ffffff", text: "#111827" },
    { name: "Ocean", primary: "#0ea5e9", bg: "#f0f9ff", text: "#0c4a6e" },
    { name: "Forest", primary: "#22c55e", bg: "#f0fdf4", text: "#14532d" },
    { name: "Sunset", primary: "#f97316", bg: "#fff7ed", text: "#7c2d12" },
    { name: "Dark", primary: "#8b5cf6", bg: "#0f172a", text: "#e2e8f0" }
  ]

layout:
  view.theme-editor:
    text.title: "Theme Editor"

    view.presets:
      text.label: "Presets"
      for (preset in presets):
        view.preset-card (on click -> applyPreset):
          view.preset-color (style="background: {{preset.primary}}")
          text.preset-name: "{{preset.name}}"

    view.customize:
      text.label: "Customize"

      view.setting:
        text.setting-label: "Primary Color"
        view.color-row:
          view.color-swatch (style="background: {{primaryColor}}")
          text: "{{primaryColor}}"

      view.setting:
        text.setting-label: "Border Radius: {{borderRadius}}px"

      view.setting:
        text.setting-label: "Font: {{fontFamily}}"

    view.css-output:
      text.label: "Generated CSS"
      view.css-block:
        text: ":root {"
        text: "  --primary: {{primaryColor}};"
        text: "  --radius: {{borderRadius}}px;"
        text: "  --font: {{fontFamily}};"
        text: "}"

style:
  .theme-editor { padding: 0; }
  .title { font-size: 20px; font-weight: 700; margin-bottom: 24px; }
  .label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #8888aa; margin-bottom: 10px; }
  .presets { margin-bottom: 24px; }
  .preset-card { display: flex; align-items: center; gap: 10px; padding: 10px 12px; background: #1a1a2e; border: 1px solid #2a2a4a; border-radius: 10px; cursor: pointer; margin-bottom: 6px; }
  .preset-card:hover { border-color: #6366f1; }
  .preset-color { width: 20px; height: 20px; border-radius: 50%; }
  .preset-name { font-size: 13px; }
  .customize { margin-bottom: 24px; }
  .setting { margin-bottom: 16px; }
  .setting-label { font-size: 13px; color: #8888aa; margin-bottom: 6px; }
  .color-row { display: flex; align-items: center; gap: 8px; }
  .color-swatch { width: 32px; height: 32px; border-radius: 8px; border: 2px solid #2a2a4a; }
  .css-output { }
  .css-block { background: #0a0a0f; border: 1px solid #2a2a4a; border-radius: 10px; padding: 14px; font-family: monospace; font-size: 12px; line-height: 1.7; }

handlers:
  applyPreset:
    log "Apply preset"
