component VoicePanel

layout:
  view.voice-section:
    button.mic-button(class="recording-{{isRecording}}" on click -> toggleVoice):
      text: "🎤"
    text.mic-status(class="status-{{isRecording ? 'recording' : 'idle'}}"): "{{isRecording ? 'Listening... speak now' : 'Click to start speaking'}}"
    view.transcript-box:
      text.transcript-label: "Transcript"
      text.transcript-text: "{{transcript || 'Waiting for voice input...'}}"
    view.manual-input:
      input.manual-field (placeholder="Or type a command..." bind value <-> manualText on keyup -> onManualKey)
      button.send-manual (on click -> sendManual): "→"

style:
  .voice-section { text-align: center; margin-bottom: 24px; }
  .mic-button { width: 80px; height: 80px; border-radius: 50%; border: 3px solid #2a2a4a; background: #1a1a2e; cursor: pointer; font-size: 32px; margin: 0 auto 12px; display: flex; align-items: center; justify-content: center; transition: all 0.3s; }
  .recording-true { border-color: #ef4444; background: rgba(239,68,68,0.1); animation: pulse 1.5s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(239,68,68,0.4); } 70% { box-shadow: 0 0 0 20px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  .mic-status { font-size: 13px; color: #8888aa; margin-bottom: 12px; }
  .status-recording { color: #ef4444; }
  .transcript-box { background: #1a1a2e; border: 1px solid #2a2a4a; border-radius: 12px; padding: 14px; text-align: left; margin-bottom: 12px; }
  .transcript-label { font-size: 10px; text-transform: uppercase; color: #8888aa; margin-bottom: 6px; }
  .transcript-text { font-size: 14px; line-height: 1.5; }
  .manual-input { display: flex; gap: 8px; }
  .manual-field { flex: 1; padding: 10px 14px; background: #1a1a2e; border: 1px solid #2a2a4a; border-radius: 10px; color: #e8e8f0; font-size: 13px; }
  .send-manual { width: 40px; background: #6366f1; color: white; border: none; border-radius: 10px; cursor: pointer; font-size: 16px; }

handlers:
  toggleVoice:
    log "Toggle voice"
  sendManual:
    log "Send manual"
  onManualKey:
    log "Manual key"
