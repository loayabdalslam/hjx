component LivePreview

layout:
  view.preview-area:
    view.preview-toolbar:
      view.device-btns:
        button.device-btn(class="dev-{{deviceView === 'desktop' ? 'active' : ''}}" on click -> setDevice): "🖥 Desktop"
        button.device-btn(class="dev-{{deviceView === 'tablet' ? 'active' : ''}}" on click -> setDevice): "📱 Tablet"
        button.device-btn(class="dev-{{deviceView === 'mobile' ? 'active' : ''}}" on click -> setDevice): "📲 Mobile"
      view.preview-status:
        view.status-dot(class="dot-{{wsConnected ? 'connected' : 'disconnected'}}")
        text: "{{wsConnected ? 'Live' : 'Disconnected'}}"
    view.preview-frame(class="frame-{{deviceView}}"):
      text: "Live Preview"

style:
  .preview-area { display: flex; flex-direction: column; height: 100%; }
  .preview-toolbar { display: flex; align-items: center; gap: 8px; padding: 8px 16px; border-bottom: 1px solid #2a2a4a; background: #12121a; }
  .device-btns { display: flex; gap: 4px; background: #0a0a0f; border-radius: 8px; padding: 3px; }
  .device-btn { padding: 4px 10px; border: none; background: none; color: #8888aa; cursor: pointer; border-radius: 6px; font-size: 12px; }
  .dev-active { background: #1a1a2e; color: #e8e8f0; }
  .preview-status { margin-left: auto; font-size: 11px; color: #8888aa; display: flex; align-items: center; gap: 6px; }
  .status-dot { width: 6px; height: 6px; border-radius: 50%; }
  .dot-connected { background: #22c55e; }
  .dot-disconnected { background: #ef4444; }
  .preview-frame { flex: 1; background: white; border-radius: 0; display: flex; align-items: center; justify-content: center; color: #9ca3af; font-size: 14px; }
  .frame-mobile { max-width: 375px; margin: 0 auto; border-left: 1px solid #2a2a4a; border-right: 1px solid #2a2a4a; }
  .frame-tablet { max-width: 768px; margin: 0 auto; border-left: 1px solid #2a2a4a; border-right: 1px solid #2a2a4a; }

handlers:
  setDevice:
    log "Set device"
