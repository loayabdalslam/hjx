component HJXStudio

imports:
  VoicePanel from "./components/VoicePanel.hjx"
  LivePreview from "./components/LivePreview.hjx"
  ComponentTree from "./components/ComponentTree.hjx"
  ThemeEditor from "./components/ThemeEditor.hjx"

state:
  projectName = "MyProject"
  components = []
  isRecording = false
  transcript = ""
  previewHtml = ""
  theme = "light"
  activePanel = "voice"
  deviceView = "desktop"
  wsConnected = false
  activity = []
  quickCommands = [
    { icon: "🧭", name: "Navbar", command: "Add a navbar" },
    { icon: "🎯", name: "Hero", command: "Add a hero section" },
    { icon: "🃏", name: "Cards", command: "Add a card grid" },
    { icon: "🦶", name: "Footer", command: "Add a footer" },
    { icon: "💬", name: "Modal", command: "Add a modal" },
    { icon: "🔍", name: "Search", command: "Add a search bar" },
    { icon: "📝", name: "Form", command: "Add a contact form" },
    { icon: "🔌", name: "API", command: "Add API integration" },
    { icon: "🌙", name: "Dark Mode", command: "Add dark mode toggle" },
    { icon: "📐", name: "Sidebar", command: "Add a sidebar" }
  ]

script:
  let ws = null;

  function connectWS() {
    const protocol = location.protocol === "https:" ? "wss:" : "ws:";
    ws = new WebSocket(`${protocol}//${location.host}`);
    ws.onopen = () => store.set({ wsConnected: true });
    ws.onclose = () => { store.set({ wsConnected: false }); setTimeout(connectWS, 2000); };
    ws.onmessage = (event) => {
      const msg = JSON.parse(event.data);
      if (msg.type === "component_added") {
        store.set({
          components: [...store.get("components"), { name: msg.component.name, code: msg.component.code }],
          previewHtml: msg.liveHtml,
          activity: [{ icon: "✨", text: msg.message, time: new Date().toLocaleTimeString() }, ...store.get("activity")]
        });
      }
    };
  }

  export function init(store) {
    connectWS();
  }

layout:
  view.studio:
    view.topbar:
      view.logo:
        view.logo-mark: "H"
        text: "Studio"
      view.nav:
        button.nav-item(class="nav-{{activePanel === 'voice' ? 'active' : ''}}" on click -> setPanel): "Build"
        button.nav-item(class="nav-{{activePanel === 'code' ? 'active' : ''}}" on click -> setPanel): "Code"
        button.nav-item(class="nav-{{activePanel === 'theme' ? 'active' : ''}}" on click -> setPanel): "Theme"
      view.actions:
        button.action (on click -> undo): "↩ Undo"
        button.action (on click -> clear): "Clear"
        button.action (on click -> export): "Export"

    view.main:
      view.left-panel:
        VoicePanel (isRecording="{{isRecording}}" transcript="{{transcript}}" on toggleVoice -> toggleVoice on sendCommand -> sendCommand)

        view.quick-section:
          text.label: "Quick Add"
          view.command-grid:
            for (cmd in quickCommands):
              view.command-btn (on click -> quickAdd):
                text.cmd-icon: "{{cmd.icon}}"
                text.cmd-name: "{{cmd.name}}"

        view.theme-section:
          text.label: "Theme"
          view.theme-row:
            view.theme-opt(class="opt-{{theme === 'light' ? 'active' : ''}}" on click -> setTheme): "☀️ Light"
            view.theme-opt(class="opt-{{theme === 'dark' ? 'active' : ''}}" on click -> setTheme): "🌙 Dark"

        ComponentTree (components="{{components}}" on remove -> removeComponent)

      view.center-panel:
        LivePreview (html="{{previewHtml}}" deviceView="{{deviceView}}" wsConnected="{{wsConnected}}" on setDevice -> setDevice)

      view.right-panel:
        view.code-header:
          view.code-tabs:
            button.ctab(class="ctab-{{activePanel === 'code' ? 'active' : ''}}" on click -> setPanel): "Code"
            button.ctab(class="ctab-{{activePanel === 'activity' ? 'active' : ''}}" on click -> setPanel): "Activity"
        view.code-body:
          if (activePanel === "code" || activePanel === "voice"):
            for (comp in components):
              view.code-block:
                view.code-header:
                  text.code-name: "{{comp.name}}.hjx"
                  button.copy-btn (on click -> copyCode): "Copy"
                text.code-content: "{{comp.code}}"
          if (activePanel === "activity"):
            for (item in activity):
              view.activity-item:
                text.act-icon: "{{item.icon}}"
                text.act-text: "{{item.text}}"
                text.act-time: "{{item.time}}"

    view.status-bar:
      text: "HJX Studio v0.1"
      text: "{{components.length}} components"

style:
  .studio { display: grid; grid-template-rows: 52px 1fr 28px; height: 100vh; background: #0a0a0f; color: #e8e8f0; font-family: system-ui; }
  .topbar { display: flex; align-items: center; justify-content: space-between; padding: 0 16px; background: #12121a; border-bottom: 1px solid #2a2a4a; }
  .logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 16px; }
  .logo-mark { width: 28px; height: 28px; background: linear-gradient(135deg, #6366f1, #a855f7); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 900; }
  .nav { display: flex; gap: 4px; }
  .nav-item { padding: 6px 14px; border: none; background: none; color: #8888aa; cursor: pointer; border-radius: 8px; font-size: 12px; }
  .nav-active { background: #1a1a2e; color: #e8e8f0; }
  .actions { display: flex; gap: 6px; }
  .action { padding: 6px 12px; border: 1px solid #2a2a4a; background: #1a1a2e; border-radius: 8px; color: #8888aa; cursor: pointer; font-size: 12px; }
  .main { display: grid; grid-template-columns: 320px 1fr 380px; }
  .left-panel, .center-panel, .right-panel { display: flex; flex-direction: column; border-right: 1px solid #2a2a4a; overflow-y: auto; padding: 16px; }
  .right-panel { border-right: none; }
  .label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #8888aa; margin-bottom: 10px; }
  .quick-section { margin-top: 20px; }
  .command-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 20px; }
  .command-btn { padding: 10px; background: #1a1a2e; border: 1px solid #2a2a4a; border-radius: 12px; cursor: pointer; text-align: center; }
  .command-btn:hover { border-color: #6366f1; }
  .cmd-icon { font-size: 18px; }
  .cmd-name { font-size: 12px; margin-top: 4px; }
  .theme-section { margin-bottom: 20px; }
  .theme-row { display: flex; gap: 8px; }
  .theme-opt { flex: 1; padding: 10px; border: 1px solid #2a2a4a; border-radius: 12px; background: #1a1a2e; cursor: pointer; text-align: center; font-size: 12px; }
  .opt-active { border-color: #6366f1; background: rgba(99,102,241,0.1); }
  .code-header { padding: 0 16px; border-bottom: 1px solid #2a2a4a; background: #12121a; }
  .code-tabs { display: flex; gap: 2px; }
  .ctab { padding: 10px 14px; border: none; background: none; color: #8888aa; cursor: pointer; font-size: 12px; border-bottom: 2px solid transparent; }
  .ctab-active { color: #6366f1; border-bottom-color: #6366f1; }
  .code-body { flex: 1; overflow-y: auto; padding: 16px; }
  .code-block { background: #0a0a0f; border: 1px solid #2a2a4a; border-radius: 12px; padding: 16px; font-family: monospace; font-size: 12px; line-height: 1.7; white-space: pre-wrap; margin-bottom: 16px; }
  .code-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; padding-bottom: 8px; border-bottom: 1px solid #2a2a4a; }
  .code-name { font-weight: 600; color: #06b6d4; }
  .copy-btn { padding: 3px 8px; background: #1a1a2e; border: 1px solid #2a2a4a; border-radius: 6px; cursor: pointer; font-size: 10px; color: #8888aa; }
  .code-content { font-family: inherit; }
  .activity-item { display: flex; gap: 10px; padding: 8px 10px; background: #1a1a2e; border-radius: 12px; margin-bottom: 8px; font-size: 12px; }
  .act-icon { font-size: 16px; }
  .act-text { flex: 1; }
  .act-time { font-size: 10px; color: #8888aa; }
  .status-bar { display: flex; justify-content: space-between; padding: 4px 16px; background: #12121a; border-top: 1px solid #2a2a4a; font-size: 11px; color: #8888aa; }

handlers:
  setPanel:
    log "Set panel"
  toggleVoice:
    log "Toggle voice"
  sendCommand:
    log "Send command"
  quickAdd:
    log "Quick add"
  setTheme:
    log "Set theme"
  undo:
    log "Undo"
  clear:
    log "Clear"
  export:
    log "Export"
  removeComponent:
    log "Remove"
  setDevice:
    log "Set device"
  copyCode:
    log "Copy"
