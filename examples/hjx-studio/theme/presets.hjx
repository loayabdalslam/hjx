component ThemePresets

state:
  presets = [
    { name: "Default Dark", bg: "#0a0a0f", surface: "#12121a", card: "#1a1a2e", text: "#e8e8f0", dim: "#8888aa", accent: "#6366f1" },
    { name: "Ocean Blue", bg: "#0c1929", surface: "#0f2744", card: "#133a5e", text: "#e0f2fe", dim: "#7dd3fc", accent: "#0ea5e9" },
    { name: "Forest Green", bg: "#0a1a0f", surface: "#0f2a14", card: "#1a3a22", text: "#dcfce7", dim: "#86efac", accent: "#22c55e" },
    { name: "Sunset Orange", bg: "#1a0f0a", surface: "#2a1a0f", card: "#3a2a1a", text: "#ffedd5", dim: "#fdba74", accent: "#f97316" },
    { name: "Purple Night", bg: "#130a1a", surface: "#1f0f2a", card: "#2e1a3e", text: "#f3e8ff", dim: "#c084fc", accent: "#a855f7" },
    { name: "Light Mode", bg: "#ffffff", surface: "#f8f9fa", card: "#ffffff", text: "#111827", dim: "#6b7280", accent: "#6366f1" },
    { name: "Rose", bg: "#1a0a0f", surface: "#2a0f1a", card: "#3e1a2a", text: "#ffe4e6", dim: "#fda4af", accent: "#f43f5e" },
    { name: "Cyan Light", bg: "#f0fdff", surface: "#e0faff", card: "#ffffff", text: "#164e63", dim: "#06b6d4", accent: "#0891b2" }
  ]

layout:
  view.presets-grid:
    for (preset in presets):
      view.preset-card (on click -> applyPreset):
        view.preset-preview:
          view.preset-bg (style="background: {{preset.bg}}")
          view.preset-surface (style="background: {{preset.surface}}")
          view.preset-accent (style="background: {{preset.accent}}")
        text.preset-name: "{{preset.name}}"

style:
  .presets-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .preset-card { padding: 12px; background: #1a1a2e; border: 1px solid #2a2a4a; border-radius: 12px; cursor: pointer; }
  .preset-card:hover { border-color: #6366f1; }
  .preset-preview { display: flex; gap: 4px; margin-bottom: 8px; }
  .preset-bg { width: 100%; height: 24px; border-radius: 4px; }
  .preset-surface { position: absolute; width: 50%; height: 16px; border-radius: 3px; bottom: 4px; left: 4px; }
  .preset-accent { width: 12px; height: 12px; border-radius: 50%; }
  .preset-name { font-size: 12px; font-weight: 500; }

handlers:
  applyPreset:
    log "Apply preset"
