target: javascript
provider: ollama
model: gemma4:31b-cloud
@description Student Score Analysis

# Data Processing Intent:
# 1. Define a list of students with scores [85, 42, 90, 66, 78, 55]
# 2. Calculate the average score
# 3. Find the highest and lowest score
# 4. Classify each as "Pass" (> 60) or "Fail"
# 5. Print a summary JSON object

scores = [85, 42, 90, 66, 78, 55]
avg = sum(scores) / length(scores)
high = max(scores)
low = min(scores)

results = []
for s in scores:
    results.push({ "score": s, "status": "Pass" if s > 60 else "Fail" })

return {
    "average": avg,
    "stats": { "max": high, "min": low },
    "detailed": results
}
