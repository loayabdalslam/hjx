component Counter
  state
    count: 0
    step: 1

  layout
    view.container:
      view.header:
        text: "Counter App"
      view.card:
        view.display:
          text: "Count: {{count}}"
        view.controls:
          button.btn-primary (on click -> increment): "+"
          button.btn-secondary (on click -> decrement): "-"
          button.btn-tertiary (on click -> reset): "Reset"
        view.step-control:
          text: "Step: {{step}}"
          input.input-field (bind value <-> step): ""

  handlers
    increment
      count = count + step

    decrement
      count = count - step

    reset
      count = 0
      step = 1

  style
    .container
      display flex
      flex-direction column
      align-items center
      justify-content center
      min-height 100vh
      background linear-gradient(135deg, #667eea 0%, #764ba2 100%)
      font-family 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif
      padding 20px

    .header
      text-align center
      margin-bottom 40px

    .header text
      font-size 48px
      font-weight bold
      color white
      margin 0

    .card
      background white
      border-radius 16px
      box-shadow 0 20px 60px rgba(0, 0, 0, 0.3)
      padding 40px
      max-width 400px
      width 100%

    .display
      text-align center
      margin-bottom 30px

    .display text
      font-size 64px
      font-weight bold
      color #667eea
      margin 0

    .controls
      display flex
      gap 12px
      margin-bottom 30px
      justify-content center

    .btn-primary, .btn-secondary, .btn-tertiary
      padding 12px 24px
      font-size 18px
      font-weight 600
      border none
      border-radius 8px
      cursor pointer
      transition all 0.3s ease
      min-width 80px

    .btn-primary
      background #667eea
      color white

    .btn-primary:hover
      background #5568d3
      transform translateY(-2px)
      box-shadow 0 8px 16px rgba(102, 126, 234, 0.4)

    .btn-secondary
      background #f093fb
      color white

    .btn-secondary:hover
      background #e07be0
      transform translateY(-2px)
      box-shadow 0 8px 16px rgba(240, 147, 251, 0.4)

    .btn-tertiary
      background #e0e0e0
      color #333

    .btn-tertiary:hover
      background #d0d0d0
      transform translateY(-2px)

    .step-control
      text-align center
      padding-top 20px
      border-top 1px solid #e0e0e0

    .step-control text
      display block
      font-size 14px
      color #666
      margin-bottom 12px

    .input-field
      width 100%
      padding 10px
      font-size 16px
      border 2px solid #667eea
      border-radius 6px
      text-align center

    .input-field:focus
      outline none
      border-color #764ba2
      box-shadow 0 0 0 3px rgba(102, 126, 234, 0.1)

    @mobile
      .container
        padding 10px

      .card
        padding 20px

      .display text
        font-size 48px

      .controls
        flex-direction column

      .btn-primary, .btn-secondary, .btn-tertiary
        width 100%
