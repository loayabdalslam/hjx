component TodoApp
state:
  items = ["Learn HJX"]
  newItem = ""
layout:
  view.container:
    text.title: "Todo List"
    input.field (bind value <-> newItem):
    button.primary (on click -> addItem): "Add"
    for (item in items):
      view.item:
        text: "{{item}}"
style:
  .container:
    container
    display flex
    flex direction column
    gap 20px
  .title:
    font size 24px
    font weight bold
  .field:
    input field
  .primary:
    button primary
  .item:
    card
    padding 12px
handlers:
  addItem:
    set items = [...items, newItem]
    set newItem = ""
