component Input

state:
  label = ""
  placeholder = "Enter text..."
  value = ""
  type = "text"

layout:
  view.form-group:
    if (label):
      text.body-small: "{{label}}"
    input.input-field (type={{type}}, placeholder={{placeholder}}, bind value <-> value)

style:
  .form-group:
    form-group
  .input-field:
    input-field
