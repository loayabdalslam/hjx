component Spinner

layout:
  view.spinner

style:
  .spinner {
    width: 24px;
    height: 24px;
    border: 3px solid #f3f3f3;
    border-top: 3px solid #6200EE;
    border-radius: 50%;
    animation: hjx-spin 1s linear infinite;
  }

  @keyframes hjx-spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
